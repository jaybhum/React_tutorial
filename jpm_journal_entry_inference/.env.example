# Settings for the LLM client. Copy to .env (git-ignored) or export in your shell.
# Never commit a real key.
JEI_LLM_BASE_URL=https://<your-resource>.cognitiveservices.azure.com/openai/v1/
JEI_LLM_MODEL=<your-deployment-name>
JEI_LLM_API_KEY=<your-api-key>

# Optional connection settings.
# Attempts after the first one. Default 5.
# JEI_LLM_MAX_RETRIES=5
# The newest TLS version to offer: 1.2 or 1.3. Leave unset for Python's default.
# Set it to 1.2 if calls fail with "SSL: UNEXPECTED_EOF_WHILE_READING".
# JEI_LLM_TLS_MAX_VERSION=1.2
